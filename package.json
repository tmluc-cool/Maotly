{
  "name": "gratisstatt",
  "productName": "GratisStatt",
  "version": "0.1.0",
  "description": "Kostenlose Open-Source-Alternativen zu bezahlter Software finden.",
  "author": "GratisStatt",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "fetch-stats": "node scripts/fetch-stats.mjs",
    "validate": "node scripts/validate-data.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run fetch-stats && npm run validate && electron-vite build && electron-builder --win --x64",
    "dist:offline": "npm run validate && electron-vite build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fuse.js": "^7.5.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
