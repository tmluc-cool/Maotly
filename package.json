{
  "name": "gratisstatt",
  "productName": "GratisStatt",
  "version": "0.1.0",
  "description": "Kostenlose Open-Source-Alternativen zu bezahlter Software finden.",
  "author": "GratisStatt",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "build-base-db": "tsx scripts/build-base-db.ts",
    "validate": "tsx scripts/validate-data.ts",
    "build-delta": "tsx scripts/build-delta.ts",
    "icon": "node scripts/make-icon.mjs",
    "dist": "tsx scripts/check-base.ts && npm run validate && electron-vite build && electron-builder --win --x64 --publish never",
    "server:dev": "npm --prefix server run dev",
    "server:deploy": "npm --prefix server run deploy",
    "fetch-base": "tsx scripts/fetch-base.ts",
    "server:typecheck": "tsc --noEmit -p server/tsconfig.json"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fuse.js": "^7.5.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
